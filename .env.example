# Copy to .env.local and fill in. All values are optional in development.

# --- Headless WordPress (blog) -------------------------------------------
# WordPress install the blog is read from. Change to the CMS subdomain
# (e.g. https://cms.netpuppys.com) once this site takes over netpuppys.com.
WORDPRESS_URL=https://netpuppys.com
# Public URL of this Next.js site (canonical / Open Graph URLs).
NEXT_PUBLIC_SITE_URL=https://netpuppys.com
# Category listed on /blogs (slug).
WORDPRESS_BLOG_CATEGORY=blog
# Secret for POST /api/revalidate?secret=... (instant refresh after publishing).
WORDPRESS_REVALIDATE_SECRET=

# --- Contact form ---------------------------------------------------------
# Web3Forms access key (leads emailed to the address registered at web3forms.com).
# Public by design — it is used in the browser. When set, the options below are unused.
NEXT_PUBLIC_WEB3FORMS_KEY=
# Fallback via /api/contact (server): Resend email or a webhook.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
FORM_WEBHOOK_URL=
